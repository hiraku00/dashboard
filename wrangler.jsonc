{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dashboard",
  "main": "worker/auth-wrapper.ts",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  // Version Preview URLs are served from a different hostname than the
  // deployed Worker, so the hostname-scoped Cloudflare Access application
  // that guards this app does not cover them. Access is this app's only
  // access control -- there is no app-layer auth behind it -- so any route
  // that Access does not cover is an unguarded route. Keep this false.
  "preview_urls": false,
  "assets": {
    "directory": "dist/client",
    // Do NOT set run_worker_first here. It routes asset requests through the
    // Worker, but vinext's app-router entry does not serve them -- every
    // /assets/*.css and *.js 404s and the whole app renders unstyled. It was
    // set to make the Worker's Access check cover static assets; that has to
    // be solved some other way.
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hiraku-watch-list",
      "database_id": "a88eabc6-5b74-48e8-b347-07720d2297d1",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // The D1 binding does not expose its own id at runtime, but
    // /api/settings/storage needs it to ask the Cloudflare Analytics API about
    // this database. Keep it here, next to the database_id it must match,
    // rather than as a second copy inside application source.
    "D1_DATABASE_ID": "a88eabc6-5b74-48e8-b347-07720d2297d1"
  },
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "hiraku-portal-files"
    }
  ],
  "triggers": {
    "crons": ["17 2 * * *"]
  }
}
