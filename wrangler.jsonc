{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dashboard",
  "main": "worker/auth-wrapper.ts",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  // Version Preview URLs are served from a different hostname than the
  // deployed Worker, so the hostname-scoped Cloudflare Access application
  // that guards this app does not cover them. Access is this app's only
  // access control -- there is no app-layer auth behind it -- so any route
  // that Access does not cover is an unguarded route. Keep this false.
  "preview_urls": false,
  "assets": {
    "directory": "dist/client",
    // Static assets are served straight from the asset store without invoking
    // the Worker by default, so the Worker's Access check would not see those
    // requests at all -- the legacy Manage Asset app under
    // /manage-asset-original/ is served this way. Route everything through the
    // Worker so one layer decides access for the whole origin.
    "run_worker_first": true,
    // run_worker_first needs the Worker to be able to serve assets itself.
    // vinext's entry already expects env.ASSETS.
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hiraku-watch-list",
      "database_id": "a88eabc6-5b74-48e8-b347-07720d2297d1",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "hiraku-portal-files"
    }
  ],
  "triggers": {
    "crons": ["17 2 * * *"]
  }
}
