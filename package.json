{
  "name": "dashboard",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs tests/shared-helpers.test.mjs tests/access.test.mjs tests/sync-summary.test.mjs tests/usage-window.test.mjs tests/manage-asset-core.test.mjs tests/history-window.test.mjs tests/watch-list-query.test.mjs tests/portal-summary.test.mjs tests/text-tube-query.test.mjs tests/watch-list-item-input.test.mjs tests/text-tube-video-input.test.mjs tests/todo-task-input.test.mjs tests/schema-parity.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "wrangler types && tsc --noEmit",
    "smoke:production": "node tests/production-smoke.test.mjs",
    "test:workers": "npm run build && vitest run"
  },
  "dependencies": {
    "mermaid": "^11.16.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "prettier": "^3.9.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "vitest": "^4.1.11",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "allowScripts": {
    "fsevents@2.3.3": true,
    "sharp@0.35.2": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.11.1": true,
    "workerd@1.20260815.1": true,
    "workerd@1.20260515.1": true,
    "esbuild@0.28.1": true,
    "esbuild@0.27.3": true
  }
}
