{
  "name": "dashboard",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && vitest run",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "wrangler types && tsc --noEmit",
    "smoke:production": "node tests/production-smoke.test.mjs",
    "backup:d1": "node scripts/backup-d1.mjs"
  },
  "dependencies": {
    "mermaid": "12.3.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-cjk-friendly": "^2.3.3",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.69.1",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitejs/plugin-rsc": "0.5.39",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.6",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "react-server-dom-webpack": "19.3.1",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.4.6",
    "vite": "8.0.13",
    "vitest": "^4.1.11",
    "wrangler": "4.163.0"
  },
  "type": "module",
  "allowScripts": {
    "fsevents@2.3.3": true,
    "sharp@0.35.2": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.11.1": true,
    "workerd@1.20260815.1": true,
    "workerd@1.20260515.1": true,
    "esbuild@0.28.1": true,
    "esbuild@0.27.3": true
  }
}
