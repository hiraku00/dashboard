# Dependencies and build output
/node_modules/
/dist/
/.next/
/.vinext/
/out/
/coverage/
*.tsbuildinfo

# Cloudflare local state and secrets
/.wrangler/
.dev.vars
.dev.vars.*
!.dev.vars.example
.env
.env.*
!.env.example

# Editor, OS and logs
.DS_Store
.idea/
.vscode/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
*.pem
*.key

# Local exports and working files
/outputs/
/work/
/tmp/

# Personal watch-list data (use the tracked example seed instead)
/data/initial-watch-list.json

# Local Manage Asset collector state and personal account configuration.
# The collector reads wallet/exchange credentials from macOS Keychain; these
# files are intentionally kept on the Mac and never committed.
/collector/data/*
!/collector/data/.gitkeep
/collector/**/__pycache__/
/collector/**/*.py[cod]
